{
  "name": "@mappedinfo/plaindeck-mcp",
  "version": "0.6.1",
  "description": "MCP server for PlainDeck: agent-native slide decks — init, validate, inspect, apply operations, add cards/tables, render",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mappedinfo/PlainDeck.git",
    "directory": "packages/plaindeck-mcp"
  },
  "homepage": "https://mappedinfo.github.io/PlainDeck/",
  "bugs": "https://github.com/Mappedinfo/PlainDeck/issues",
  "keywords": [
    "slides",
    "presentation",
    "mcp",
    "model-context-protocol",
    "agent",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "plaindeck.cordis.yml"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "plaindeck-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "plaindeck": "0.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~5.7.2"
  }
}
