{
  "name": "plaindeck",
  "version": "0.2.4",
  "description": "Git-native slide format, Agent API, CLI, and renderer",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mappedinfo/PlainDeck.git",
    "directory": "packages/plaindeck"
  },
  "homepage": "https://mappedinfo.github.io/PlainDeck/",
  "bugs": "https://github.com/Mappedinfo/PlainDeck/issues",
  "keywords": [
    "slides",
    "presentation",
    "git",
    "json",
    "ai-agent",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    }
  },
  "bin": {
    "plaindeck": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "playwright": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
