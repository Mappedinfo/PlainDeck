{
  "name": "@plaindeck/react",
  "version": "0.3.0",
  "description": "Shared React renderer for PlainDeck JSON slides",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mappedinfo/PlainDeck.git",
    "directory": "packages/react"
  },
  "homepage": "https://mappedinfo.github.io/PlainDeck/",
  "bugs": "https://github.com/Mappedinfo/PlainDeck/issues",
  "keywords": ["slides", "presentation", "react", "json", "ai-agent"],
  "engines": { "node": ">=22" },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "prepack": "npm run build"
  },
  "dependencies": {
    "plaindeck": "0.3.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
