{
  "name": "plaindeck-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && vite",
    "build": "npm run build:packages && tsc -b && vite build",
    "build:package": "npm run build -w plaindeck",
    "build:packages": "npm run build -w plaindeck && npm run build -w @mappedinfo/plaindeck-react && npm run build -w @mappedinfo/plaindeck-remotion",
    "preview": "vite preview",
    "test": "npm run build:packages && vitest run",
    "test:pack": "node scripts/test-pack.mjs",
    "styles:migrate": "node scripts/migrate-juya-styles.mjs",
    "styles:check": "node scripts/migrate-juya-styles.mjs --check",
    "test:render": "npm run build:package && PLAINDECK_BROWSER_TESTS=1 vitest run packages/plaindeck/test/render.test.ts",
    "test:remotion": "npm run build:packages && node scripts/render-remotion-demo.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run build:packages && tsc -b --pretty false"
  },
  "dependencies": {
    "@mappedinfo/plaindeck-react": "0.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "plaindeck": "0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@remotion/cli": "4.0.504",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
