[
  { "op": "rename-slide", "slide": "./slides/001-cover.json", "name": "Cover" },
  { "op": "set-element", "slide": "./slides/001-cover.json", "element": "kicker", "patch": { "text": "PNAS 2026 · NEUROSCIENCE · LANGUAGE OF THOUGHT" } },
  { "op": "set-element", "slide": "./slides/001-cover.json", "element": "title", "patch": { "text": "思维的语言，\n不是自然语言", "fontSize": 76 } },
  { "op": "set-element", "slide": "./slides/001-cover.json", "element": "authors", "patch": { "text": "Kean et al. · PNAS · DOI:10.1073/pnas.2520095123" } },
  { "op": "set-element", "slide": "./slides/001-cover.json", "element": "hint", "patch": { "text": "ONE PAPER · ONE READING · EIGHT SLIDES" } },

  { "op": "rename-slide", "slide": "./slides/002-problem.json", "name": "The problem" },
  { "op": "set-element", "slide": "./slides/002-problem.json", "element": "kicker", "patch": { "text": "01 / THE PROBLEM" } },
  { "op": "set-element", "slide": "./slides/002-problem.json", "element": "statement", "patch": { "text": "两千多年前亚里士多德就画下这条界线：\n思考，是否需要语言？", "fontSize": 56 } },
  { "op": "set-element", "slide": "./slides/002-problem.json", "element": "context", "patch": { "text": "数学推理、因果推理、心智理论，都曾在失语症患者身上完好——但先例各说各话。" } },

  { "op": "rename-slide", "slide": "./slides/003-contributions.json", "name": "Two lines of evidence" },
  { "op": "set-element", "slide": "./slides/003-contributions.json", "element": "title", "patch": { "text": "两条证据线，围堵一个问题" } },
  { "op": "set-element", "slide": "./slides/003-contributions.json", "element": "item-1-title", "patch": { "text": "fMRI：健康大脑" } },
  { "op": "set-element", "slide": "./slides/003-contributions.json", "element": "item-1-body", "patch": { "text": "每个被试单独做语言定位任务，逐个划出语言网络，再看推理任务激活了多少。" } },
  { "op": "set-element", "slide": "./slides/003-contributions.json", "element": "item-2-title", "patch": { "text": "行为：重度失语症患者" } },
  { "op": "set-element", "slide": "./slides/003-contributions.json", "element": "item-2-body", "patch": { "text": "语言能力严重受损的患者，还能不能完成归纳与演绎推理。" } },
  { "op": "set-element", "slide": "./slides/003-contributions.json", "element": "item-3-title", "patch": { "text": "三种任务范式" } },
  { "op": "set-element", "slide": "./slides/003-contributions.json", "element": "item-3-body", "patch": { "text": "规则归纳测归纳，三段论和矩阵测演绎，覆盖两种推理类型。" } },

  { "op": "rename-slide", "slide": "./slides/004-figure.json", "name": "Three task paradigms" },
  { "op": "set-element", "slide": "./slides/004-figure.json", "element": "fig-label", "patch": { "text": "FIGURE 1 · PDF P.3" } },
  { "op": "set-element", "slide": "./slides/004-figure.json", "element": "title", "patch": { "text": "三种任务，覆盖归纳与演绎" } },
  { "op": "set-element", "slide": "./slides/004-figure.json", "element": "caption", "patch": { "text": "图注：规则归纳、三段论、矩阵推理，三种范式覆盖归纳与演绎。" } },
  { "op": "set-element", "slide": "./slides/004-figure.json", "element": "notes-label", "patch": { "text": "KEY POINTS" } },
  { "op": "set-element", "slide": "./slides/004-figure.json", "element": "note-1", "patch": { "text": "规则归纳：从样例中猜出变换规则。" } },
  { "op": "set-element", "slide": "./slides/004-figure.json", "element": "note-2", "patch": { "text": "三段论：判断结论是否必然成立。" } },
  { "op": "set-element", "slide": "./slides/004-figure.json", "element": "note-3", "patch": { "text": "矩阵推理：找出不符合规律的一项。" } },
  { "op": "set-element", "slide": "./slides/004-figure.json", "element": "source", "patch": { "text": "KEAN ET AL. 2026 · PNAS" } },

  { "op": "rename-slide", "slide": "./slides/005-table.json", "name": "Language network response" },
