  { "op": "set-element", "slide": "./slides/005-table.json", "element": "title", "patch": { "text": "语言网络，对逻辑推理几乎无感" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "header-1", "patch": { "text": "任务" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "header-2", "patch": { "text": "推理类型" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "header-3", "patch": { "text": "语言网络响应" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "cell-1-1", "patch": { "text": "语言定位" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "cell-1-2", "patch": { "text": "——（对照）" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "cell-1-3", "patch": { "text": "强烈响应" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "cell-2-1", "patch": { "text": "规则归纳" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "cell-2-2", "patch": { "text": "归纳" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "cell-2-3", "patch": { "text": "微弱" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "cell-3-1", "patch": { "text": "三段论与矩阵" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "cell-3-2", "patch": { "text": "演绎" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "cell-3-3", "patch": { "text": "几乎不动" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "takeaway", "patch": { "text": "读法：对语言强烈响应的脑区，对逻辑推理几乎无响应。" } },
  { "op": "set-element", "slide": "./slides/005-table.json", "element": "source", "patch": { "text": "KEAN ET AL. 2026 · PNAS" } },

  { "op": "rename-slide", "slide": "./slides/006-versus.json", "name": "Aphasia patients" },
  { "op": "set-element", "slide": "./slides/006-versus.json", "element": "title", "patch": { "text": "语言坏了，推理还在" } },
  { "op": "set-element", "slide": "./slides/006-versus.json", "element": "left-label", "patch": { "text": "PREDICTION" } },
  { "op": "set-element", "slide": "./slides/006-versus.json", "element": "left-title", "patch": { "text": "如果思维用语言" } },
  { "op": "set-element", "slide": "./slides/006-versus.json", "element": "left-body", "patch": { "text": "失语症应当摧毁推理能力：语言系统崩了，思考就该跟着崩。" } },
  { "op": "set-element", "slide": "./slides/006-versus.json", "element": "right-label", "patch": { "text": "OBSERVED" } },
  { "op": "set-element", "slide": "./slides/006-versus.json", "element": "right-title", "patch": { "text": "实际观察到的" } },
  { "op": "set-element", "slide": "./slides/006-versus.json", "element": "right-body", "patch": { "text": "两位重度失语症患者，归纳与矩阵推理表现正常；归纳激活的是多需求网络。" } },
  { "op": "set-element", "slide": "./slides/006-versus.json", "element": "verdict", "patch": { "text": "结论：语言是沟通和压缩的工具，不负责思考本身。" } },

  { "op": "rename-slide", "slide": "./slides/007-limits.json", "name": "Limitations" },
  { "op": "set-element", "slide": "./slides/007-limits.json", "element": "title", "patch": { "text": "边界要说清楚" } },
  { "op": "set-element", "slide": "./slides/007-limits.json", "element": "intro", "patch": { "text": "两位患者样本极小，结论限于成年大脑。" } },
  { "op": "set-element", "slide": "./slides/007-limits.json", "element": "limit-1-title", "patch": { "text": "证据边界" } },
  { "op": "set-element", "slide": "./slides/007-limits.json", "element": "limit-1-body", "patch": { "text": "失语症部分仅两位被试。重度损伤本身罕见，样本虽小，个案价值高。" } },
  { "op": "set-element", "slide": "./slides/007-limits.json", "element": "limit-2-title", "patch": { "text": "适用边界" } },
  { "op": "set-element", "slide": "./slides/007-limits.json", "element": "limit-2-body", "patch": { "text": "结论限于成年大脑，不涉及语言在童年逻辑概念习得中的作用。" } },
  { "op": "set-element", "slide": "./slides/007-limits.json", "element": "future", "patch": { "text": "未来工作：更大样本的失语症研究，以及儿童发展阶段的追踪。" } },

  { "op": "rename-slide", "slide": "./slides/008-closing.json", "name": "Takeaway" },
  { "op": "set-element", "slide": "./slides/008-closing.json", "element": "quote", "patch": { "text": "思维有自己的语言。" } },
  { "op": "set-element", "slide": "./slides/008-closing.json", "element": "attribution", "patch": { "text": "—— Kean et al. 2026 · PNAS · DOI:10.1073/pnas.2520095123" } }
]
